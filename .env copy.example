# Client-exposed env vars must use PUBLIC_ prefix (Astro convention).
# Copy to .env (gitignored) and fill with real values before building.

# Umami analytics (cookieless). Both must be set or the script is not injected.
# PUBLIC_UMAMI_SRC: script URL (e.g. https://cloud.umami.is/script.js for Umami Cloud).
# PUBLIC_UMAMI_ID:  website ID (UUID) from your Umami dashboard.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=

# Google Site Verification token from Search Console. Empty → meta tag not injected.
PUBLIC_GSV=example
