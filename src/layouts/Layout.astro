---
import "@/styles/global.css";
import NavBar from "@/components/ui/NavBar.astro";
import Footer from "@/components/ui/Footer.astro";
import Loader from "@/components/ui/Loader.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImage?: string;
  noindex?: boolean;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = "Valentina Ramírez | Full Stack Developer · Django + React · IA & Seguridad",
  description = "Full Stack Developer especializada en Django y React. Construyo productos completos: backend sólido, frontend funcional, integración de IA y seguridad desde el diseño.",
  image = "/images/profile.webp",
  ogImage,
  noindex = false,
  lang = "es",
  alternates = [],
} = Astro.props;

const ogLocale = lang === "en" ? "en_US" : "es_CO";
const inLanguage = lang === "en" ? "en-US" : "es-CO";
const t = useTranslations(lang as Lang);

const site = "https://wavival.dev";
const canonicalURL = new URL(Astro.url.pathname, site);
const personImage = new URL(image, site);
const socialCard = ogImage ? new URL(ogImage, site) : new URL("/images/og-card.png", site);
const socialCardAlt = "Valentina Ramírez — Full Stack Developer · Django + React · IA & Seguridad";

const GA_ID = import.meta.env.PUBLIC_GA_ID;
const GSV = import.meta.env.PUBLIC_GSV;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      name: "Valentina Ramírez",
      url: site,
      image: personImage.toString(),
      jobTitle: "Full Stack Developer",
      description: description,
      worksFor: {
        "@type": "Organization",
        name: "Lúmina W",
        url: "https://luminaw.co",
      },
      sameAs: [
        "https://linkedin.com/in/wavival",
        "https://github.com/wavival",
        "https://instagram.com/wavival",
        "https://platzi.com/p/wavival",
        "https://luminaw.co",
        "https://blog.luminaw.co",
        "https://wa.me/573116865766",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: site,
      name: title,
      description: description,
      inLanguage: inLanguage,
      author: { "@id": `${site}/#person` },
    },
  ],
});
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (t === "dark" || (t === null && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Valentina Ramírez" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={socialCardAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Valentina Ramírez" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard} />
    <meta name="twitter:image:alt" content={socialCardAlt} />
    {GSV && <meta name="google-site-verification" content={GSV} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}brand/logo-w.ico`} />
    <link rel="icon" type="image/webp" href={`${import.meta.env.BASE_URL}brand/logo-w.webp`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}brand/logo-w.webp`} />
    <meta name="theme-color" content="#f0f4ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="image"
      href={`${import.meta.env.BASE_URL}images/profile.webp`}
      fetchpriority="high"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Raleway:wght@600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Raleway:wght@600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {
      GA_ID && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config","${GA_ID}");`}
          />
        </>
      )
    }
    <script>
      import AOS from "aos";
      import "aos/dist/aos.css";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      AOS.init({
        duration: reduceMotion ? 0 : 800,
        easing: "ease-in-out",
        once: true,
        offset: reduceMotion ? 0 : 100,
      });
    </script>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="bg-[var(--bg-page)] text-[var(--text-primary)] antialiased">
    <Loader />
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[var(--brand-blue)] focus:text-white focus:rounded-lg focus:font-semibold focus:outline-none"
    >
      {t("common.skip")}
    </a>
    <NavBar />
    <main id="main-content" class="pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
