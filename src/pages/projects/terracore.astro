---
import Layout from "@/layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const site = "https://wavival.dev";

const pageTitle =
  "TerraCore — Plataforma SaaS agroindustrial offline-first | Valentina Ramírez";
const pageDescription =
  "Case study: cómo construí TerraCore, SaaS de gestión de finca para el campo colombiano. Django REST + React PWA con arquitectura offline-first, multirol y 6 módulos integrados.";

const stack = ["Django REST", "React", "PWA", "Offline-first", "PostgreSQL"];

const painPoints = [
  {
    icon: "🔎",
    title: "Sin trazabilidad",
    text: "¿Cuándo se vacunó ese animal? Nadie lo sabe con certeza.",
  },
  {
    icon: "📦",
    title: "Stock invisible",
    text: "El concentrado se acaba y nadie lo vio venir.",
  },
  {
    icon: "📡",
    title: "Sin señal, sin datos",
    text: "En el corral no hay internet. El registro queda para después, y después nunca llega.",
  },
];

const modules = [
  {
    icon: "📊",
    name: "Dashboard",
    text: "KPIs en tiempo real: animales activos, producción mensual, insumos, alertas e ingresos estimados.",
  },
  {
    icon: "🐄",
    name: "Animales",
    text: "Registro completo: ID, raza, peso, estado de salud y ubicación por potrero.",
  },
  {
    icon: "📦",
    name: "Insumos",
    text: "Alimentos, medicamentos y suministros con alertas de stock mínimo y proveedor.",
  },
  {
    icon: "🔧",
    name: "Herramientas",
    text: "Equipos y maquinaria con estado y bitácora de mantenimiento.",
  },
  {
    icon: "🥛",
    name: "Producción",
    text: "Lotes de leche, huevos y cultivos con trazabilidad de insumos y horas.",
  },
  {
    icon: "💉",
    name: "Salud Animal",
    text: "Vacunas, alertas de refuerzo y historial sanitario por animal.",
  },
];

const decisions = [
  {
    title: "Offline-first con PWA",
    context:
      "En potreros y corrales la señal es intermitente o inexistente.",
    tradeoff:
      "Una web app tradicional fallaría. Una app nativa requeriría publicación en stores y más mantenimiento.",
    decision:
      "PWA con Service Worker que persiste registros localmente y sincroniza en batch cuando vuelve la red. Se instala desde el navegador sin pasar por App Store.",
  },
  {
    title: "Módulos acoplados con eventos internos",
    context:
      "Cada acción del campo tiene consecuencias en otros registros (vacuna → insumo → salud → agenda).",
    tradeoff:
      "Módulos aislados son más fáciles de mantener pero obligan al usuario a actualizar cada sección manualmente.",
    decision:
      "Arquitectura de eventos internos: una acción dispara actualizaciones en cascada en todos los módulos relacionados.",
  },
  {
    title: "Multirol sin complejidad para el usuario",
    context:
      "Una finca tiene dueño, administrador y operarios de campo con necesidades de información distintas.",
    tradeoff:
      "Un solo rol lo ve todo (riesgo de exposición y sobrecarga); demasiados roles complican la gestión.",
    decision:
      "Tres roles con permisos diferenciados (Admin / Operario / Solo lectura). Cada usuario ve solo lo que necesita según su flujo de trabajo.",
  },
  {
    title: "Cumplimiento Ley 1581 de 2012 desde el diseño",
    context:
      "Los datos de producción y sanidad animal son sensibles para el productor. La confianza es bloqueante.",
    tradeoff:
      "Almacenar más datos mejora el producto pero aumenta la responsabilidad legal y la desconfianza.",
    decision:
      "Sin minería de datos para terceros, sin entrenamiento de modelos con datos de usuario, exportación completa en 48h si el cliente se va. TLS en todos los endpoints.",
  },
];

const chainSteps = [
  'Vacuna aplicada (ej. Triple Bovina a "La Canela")',
  "Insumo descontado automáticamente (−1 dosis del stock)",
  "Próximo refuerzo agendado (en 14 días)",
  "Estado de salud del animal actualizado",
];

const results = [
  { metric: "−42%", label: "tiempo administrativo", note: "fincas piloto" },
  { metric: "1 semana", label: "tiempo de onboarding", note: "sin consultores" },
  { metric: "6 módulos", label: "integrados", note: "en una sola plataforma" },
];

const softwareLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TerraCore",
  description:
    "Plataforma SaaS de gestión agroindustrial para fincas medianas colombianas. Inventario, producción y salud animal en una sola pantalla.",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Android, iOS (PWA)",
  url: "https://terracoreapp.co",
  author: {
    "@type": "Person",
    name: "Valentina Ramírez",
    url: "https://wavival.dev",
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "COP",
    price: "2500000",
  },
});
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://terracoreapp.co/terracore.png">
  <!-- SECCIÓN 1 — HERO -->
  <section class="section !pb-12">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col gap-5" data-aos="fade-up">
        <span class="chip w-fit !text-[var(--text-primary)]">· Producto SaaS · En producción</span>
        <h1 class="font-display font-bold text-3xl md:text-5xl leading-tight text-[var(--text-primary)]">
          TerraCore — gestión de finca sin Excel
        </h1>
        <p class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed max-w-xl">
          El campo colombiano gestiona inventario, salud animal y producción en cuadernos y hojas de
          cálculo. Construí TerraCore para que eso cambie.
        </p>
        <div class="flex flex-wrap gap-2">
          {stack.map((s) => <span class="chip !text-[var(--text-primary)]">{s}</span>)}
        </div>
        <div class="flex flex-wrap items-center gap-5 mt-2">
          <a
            href="https://terracoreapp.co"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
            aria-label="Ver el sitio en vivo de TerraCore"
          >
            Ver sitio en vivo →
          </a>
          <a href={base} class="link" aria-label="Volver al portfolio">← Volver al portfolio</a>
        </div>
      </div>

      <div data-aos="fade-up" data-aos-delay="100">
        <img
          src="https://terracoreapp.co/screens/dashboard-2.webp"
          alt="Dashboard de TerraCore con KPIs en tiempo real"
          width="1200"
          height="800"
          loading="eager"
          decoding="async"
          class="w-full h-auto rounded-[var(--radius-lg)] border border-[var(--border-base)] shadow-[var(--shadow-base)]"
        />
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2 — EL PROBLEMA -->
  <section class="bg-[var(--brand-dark)] text-[#e8eaf6]">
    <div class="w-full max-w-5xl mx-auto px-6 py-24">
      <h2 class="font-display font-bold text-3xl md:text-4xl" data-aos="fade-up">
        El campo no cabe en Excel
      </h2>
      <p class="mt-4 max-w-3xl text-[#b8bccb] leading-relaxed" data-aos="fade-up">
        Los productores de fincas medianas en Colombia operan con tres herramientas que no se hablan:
        el cuaderno, la hoja de cálculo y el grupo de WhatsApp. El resultado es información
        incompleta, decisiones tardías y tiempo que se va en administración en vez de en el campo.
      </p>

      <div class="grid md:grid-cols-3 gap-6 mt-12">
        {
          painPoints.map((p, i) => (
            <div
              class="rounded-2xl border border-white/10 bg-white/[0.04] p-6"
              data-aos="fade-up"
              data-aos-delay={i * 100}
            >
              <span class="text-3xl" aria-hidden="true">
                {p.icon}
              </span>
              <h3 class="font-display font-bold text-lg mt-3">{p.title}</h3>
              <p class="mt-2 text-sm text-[#b8bccb] leading-relaxed">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3 — MÉTRICA GANCHO -->
  <section class="bg-[var(--brand-blue)] text-white">
    <div class="w-full max-w-5xl mx-auto px-6 py-20 text-center flex flex-col items-center gap-2">
      <span class="font-display font-bold text-6xl md:text-8xl leading-none" data-aos="zoom-in"
        >−42%</span
      >
      <span class="font-display font-semibold text-lg md:text-xl">
        menos tiempo en tareas administrativas
      </span>
      <span class="text-sm text-white/80">Resultado medido en fincas piloto reales</span>
    </div>
  </section>

  <!-- SECCIÓN 4 — LOS 6 MÓDULOS -->
  <section class="section">
    <h2 class="section-title" data-aos="fade-up">Seis módulos que conversan entre sí</h2>
    <p class="text-[var(--text-muted)] max-w-2xl mt-2" data-aos="fade-up">
      No son pantallas aisladas. Una acción en un módulo actualiza todo el sistema.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {
        modules.map((m, i) => (
          <article class="card !min-h-0 flex flex-col gap-2" data-aos="fade-up" data-aos-delay={i * 80}>
            <span class="text-3xl" aria-hidden="true">
              {m.icon}
            </span>
            <h3 class="font-display font-bold text-lg text-[var(--text-primary)]">{m.name}</h3>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">{m.text}</p>
          </article>
        ))
      }
    </div>

    <div
      class="mt-12 rounded-2xl border border-[var(--border-base)] border-l-4 border-l-[var(--brand-blue)] bg-[var(--bg-blur)] p-8"
      data-aos="fade-up"
    >
      <h3 class="font-display font-bold text-xl text-[var(--text-primary)]">
        Si registras una vacuna, pasan tres cosas solas.
      </h3>
      <ol class="mt-5 flex flex-col gap-3">
        {
          chainSteps.map((step, i) => (
            <li class="flex items-start gap-3 text-[var(--text-muted)]">
              <span class="text-[var(--brand-blue)] font-bold shrink-0" aria-hidden="true">
                {i === 0 ? "•" : "→"}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- SECCIÓN 5 — DECISIONES TÉCNICAS -->
  <section class="section !pt-0">
    <h2 class="section-title" data-aos="fade-up">Decisiones de arquitectura</h2>
    <p class="text-[var(--text-muted)] max-w-2xl mt-2" data-aos="fade-up">
      Las restricciones del campo colombiano —mala señal, usuarios no técnicos, múltiples roles—
      definieron cada decisión de diseño.
    </p>

    <div class="flex flex-col gap-6 mt-10">
      {
        decisions.map((d, i) => (
          <article class="card !min-h-0" data-aos="fade-up" data-aos-delay={i * 60}>
            <h3 class="font-display font-bold text-xl text-[var(--text-primary)]">
              {i + 1}. {d.title}
            </h3>
            <dl class="mt-4 flex flex-col gap-3 text-sm leading-relaxed">
              <div>
                <dt class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                  Contexto
                </dt>
                <dd class="text-[var(--text-muted)] mt-1">{d.context}</dd>
              </div>
              <div>
                <dt class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                  Trade-off
                </dt>
                <dd class="text-[var(--text-muted)] mt-1">{d.tradeoff}</dd>
              </div>
              <div>
                <dt class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                  Decisión
                </dt>
                <dd class="text-[var(--text-primary)] mt-1">{d.decision}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <!-- SECCIÓN 6 — RESULTADO -->
  <section class="section !pt-0">
    <h2 class="section-title" data-aos="fade-up">Resultado</h2>

    <div class="grid sm:grid-cols-3 gap-6 mt-10">
      {
        results.map((r, i) => (
          <div
            class="rounded-2xl border border-[var(--border-base)] bg-[var(--bg-card)] p-8 text-center"
            data-aos="fade-up"
            data-aos-delay={i * 80}
          >
            <span class="block font-display font-bold text-4xl md:text-5xl text-[var(--brand-blue)]">
              {r.metric}
            </span>
            <span class="block mt-2 font-semibold text-[var(--text-primary)]">{r.label}</span>
            <span class="block mt-1 text-sm text-[var(--text-muted)]">{r.note}</span>
          </div>
        ))
      }
    </div>

    <p class="text-[var(--text-muted)] leading-relaxed max-w-3xl mt-8" data-aos="fade-up">
      TerraCore está en producción en <strong class="text-[var(--text-primary)]">terracoreapp.co</strong>
      con fincas reales en Antioquia. El modelo SaaS corre en tres planes (Semilla, Profesional,
      Enterprise) con trial de 30 días.
    </p>

    <div class="mt-6" data-aos="fade-up">
      <a
        href="https://terracoreapp.co"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        aria-label="Ver TerraCore en vivo"
      >
        Ver TerraCore en vivo →
      </a>
    </div>
  </section>

  <!-- SECCIÓN 7 — NAVEGACIÓN ENTRE PROYECTOS -->
  <nav
    aria-label="Navegación entre proyectos"
    class="w-full max-w-5xl mx-auto px-6 pb-24 pt-10 border-t border-[var(--border-base)] flex flex-col sm:flex-row items-center justify-between gap-6"
  >
    <a href={`${base}projects/nullbreach`} class="link" aria-label="Proyecto anterior: NullBreach">
      ← NullBreach
    </a>
    <a href={base} class="link !text-[var(--text-muted)]" aria-label="Volver al portfolio">
      Volver al portfolio
    </a>
    <a href={`${base}projects/root`} class="link" aria-label="Proyecto siguiente: Root">Root →</a>
  </nav>

  <script is:inline type="application/ld+json" set:html={softwareLd} />
</Layout>
