---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import { caseStudies, type Project } from "@/data/projects";

export function getStaticPaths() {
  // terracore has its own hand-built page at /projects/terracore.astro
  return caseStudies
    .filter((project) => project.slug !== "terracore")
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = "https://wavival.dev";

const tagStyles: Record<string, string> = {
  green: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
  blue: "bg-blue-100 text-[var(--brand-blue)] dark:bg-blue-900/30",
  orange: "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
  gray: "bg-[var(--bg-blur)] text-[var(--text-muted)]",
};

const pageTitle = `${project.title} — Caso de estudio | Valentina Ramírez`;
const pageURL = `${site}${base}projects/${project.slug}`;

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: site },
    {
      "@type": "ListItem",
      position: 2,
      name: "Proyectos",
      item: `${site}${base}#projects`,
    },
    { "@type": "ListItem", position: 3, name: project.title, item: pageURL },
  ],
});

const projectLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.title,
  description: project.metaDescription ?? project.solution,
  url: pageURL,
  programmingLanguage: project.stack,
  author: { "@id": `${site}/#person` },
});
---

<Layout title={pageTitle} description={project.metaDescription ?? project.solution}>
  <article class="section">
    <nav aria-label="Ruta de navegación" class="text-sm text-[var(--text-muted)]">
      <Link href={base} class="!text-xs">Inicio</Link>
      <span class="mx-2" aria-hidden="true">/</span>
      <Link href={`${base}#projects`} class="!text-xs">Proyectos</Link>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-xs text-[var(--text-primary)]">{project.title}</span>
    </nav>

    <header class="mt-8 flex flex-col gap-4" data-aos="fade-up">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="font-display font-bold text-3xl md:text-4xl text-[var(--text-primary)]">
          {project.title}
        </h1>
        <span class={`text-xs font-semibold px-3 py-1 rounded-full ${tagStyles[project.tagColor]}`}>
          {project.tag}
        </span>
      </div>

      <p class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed max-w-3xl">
        {project.solution}
      </p>

      <div class="flex flex-wrap gap-2">
        {project.stack.map((s) => <span class="chip !text-[var(--text-primary)]">{s}</span>)}
      </div>
    </header>

    {
      project.image && (
        <img
          src={`${base}${project.image}`}
          alt={project.imageAlt}
          width={project.imageWidth}
          height={project.imageHeight}
          loading="lazy"
          decoding="async"
          class="mt-10 w-full h-auto rounded-[var(--radius-md)] border border-[var(--border-base)]"
        />
      )
    }

    <div class="mt-12 flex flex-col gap-10 max-w-3xl">
      <section data-aos="fade-up">
        <h2 class="section-subtitle !mb-2">El problema</h2>
        <p class="text-[var(--text-muted)] leading-relaxed">{project.problem}</p>
      </section>

      {
        project.architecture && (
          <section data-aos="fade-up">
            <h2 class="section-subtitle !mb-2">Qué construí</h2>
            <ul class="list-disc pl-5 space-y-2 text-[var(--text-muted)] leading-relaxed">
              {project.architecture.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        project.results && (
          <section data-aos="fade-up">
            <h2 class="section-subtitle !mb-2">Resultados</h2>
            <ul class="list-disc pl-5 space-y-2 text-[var(--text-muted)] leading-relaxed">
              {project.results.map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        project.learnings && (
          <section data-aos="fade-up">
            <h2 class="section-subtitle !mb-2">Aprendizajes</h2>
            <ul class="list-disc pl-5 space-y-2 text-[var(--text-muted)] leading-relaxed">
              {project.learnings.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        project.links.length > 0 && (
          <section data-aos="fade-up" class="flex flex-wrap gap-5">
            {project.links.map((l) => (
              <Link href={l.href} target="_blank" aria-label={l.ariaLabel}>
                {l.text}
              </Link>
            ))}
          </section>
        )
      }
    </div>

    <div
      class="mt-16 pt-10 border-t border-[var(--border-base)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6"
    >
      <p class="text-[var(--text-muted)]">¿Tienes un proyecto parecido en mente?</p>
      <div class="flex items-center gap-5 flex-wrap">
        <Button href={`${base}#contact`} aria-label="Ir a la sección de contacto">
          Hablemos
        </Button>
        <Link href={`${base}#projects`} aria-label="Volver a todos los proyectos">
          Ver todos los proyectos
        </Link>
      </div>
    </div>
  </article>

  <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
  <script is:inline type="application/ld+json" set:html={projectLd} />
</Layout>
