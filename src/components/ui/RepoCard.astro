---
import type { GithubRepo } from "@/data/github";

interface Props {
  repo: GithubRepo;
  lang?: "es" | "en";
  variant?: "featured" | "resource";
}

const { repo, lang = "es", variant = "featured" } = Astro.props;

const starLabel = (n: number) =>
  lang === "en" ? (n === 1 ? "star" : "stars") : n === 1 ? "estrella" : "estrellas";
const ariaLabel =
  lang === "en" ? `${repo.name} repository on GitHub` : `Repositorio ${repo.name} en GitHub`;

const featuredCls =
  "card !p-5 !min-h-0 h-full flex flex-col gap-2 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]";
const resourceCls =
  "group h-full flex flex-col gap-2 rounded-xl border border-[var(--border-base)] bg-transparent p-5 no-underline transition-all duration-300 hover:-translate-y-1 hover:border-[var(--brand-blue)] hover:shadow-[0_10px_28px_rgba(64,123,255,0.14)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]";

const isResource = variant === "resource";
const nameCls = isResource
  ? "font-mono text-sm text-[var(--brand-blue-text)]"
  : "font-display text-[var(--brand-blue-text)]";
---

<a
  href={repo.html_url}
  target="_blank"
  rel="noopener noreferrer"
  class={isResource ? resourceCls : featuredCls}
  aria-label={ariaLabel}
>
  <strong class={nameCls}>{repo.name}</strong>
  {
    repo.description && (
      <p class="text-sm text-[var(--text-muted)] leading-relaxed">{repo.description}</p>
    )
  }
  <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)] mt-auto pt-1">
    {
      repo.language && (
        <span class="inline-flex items-center gap-1.5">
          <span
            class="inline-block w-2 h-2 rounded-full bg-[var(--brand-blue)]"
            aria-hidden="true"
          />
          {repo.language}
        </span>
      )
    }
    {
      repo.stargazers_count > 0 && (
        <span>
          {repo.stargazers_count} {starLabel(repo.stargazers_count)}
        </span>
      )
    }
  </div>
</a>
