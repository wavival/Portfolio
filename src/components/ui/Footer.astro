---
import Link from "@/components/ui/Link.astro";
import { getLangFromUrl, useTranslations, homeHref } from "@/i18n/utils";

const BASE = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = homeHref(lang);
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-[var(--border-base)] mt-24">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between gap-10 mb-10">
      <div class="flex flex-col gap-3">
        <a href={home} aria-label={t("nav.homeAria")}>
          <img
            src={`${BASE}brand/logo-w.webp`}
            alt="wavival.dev"
            class="h-10 w-auto"
            width="120"
            height="40"
          />
        </a>
        <p class="text-xs text-[var(--text-primary)] max-w-[240px]">{t("footer.tagline")}</p>
        <div class="flex items-center gap-3 mt-2">
          <Link
            href="https://linkedin.com/in/wavival"
            target="_blank"
            icon="linkedin"
            aria-label={t("footer.linkedinAria")}
          />
          <Link
            href="https://github.com/wavival"
            target="_blank"
            icon="github"
            aria-label={t("footer.githubAria")}
          />
          <Link
            href="https://instagram.com/wavival"
            target="_blank"
            icon="instagram"
            aria-label={t("footer.instagramAria")}
          />
        </div>
      </div>

      <nav aria-label={t("footer.siteNavAria")} class="flex flex-col gap-3">
        <span
          class="text-xs font-display font-bold uppercase tracking-widest text-[var(--text-primary)]"
          aria-hidden="true">{t("footer.navHeading")}</span
        >
        <Link href={`${BASE}projects`} class="!text-xs" aria-label={t("nav.projects")}
          >{t("nav.projects")}</Link
        >
        <Link href={`${BASE}services`} class="!text-xs" aria-label={t("nav.services")}
          >{t("nav.services")}</Link
        >
        <Link href={`${BASE}stack`} class="!text-xs" aria-label={t("nav.stack")}
          >{t("nav.stack")}</Link
        >
        <Link href={`${BASE}about`} class="!text-xs" aria-label={t("nav.about")}
          >{t("nav.about")}</Link
        >
        <Link href={`${BASE}contact`} class="!text-xs" aria-label={t("nav.contact")}
          >{t("nav.contact")}</Link
        >
      </nav>

      <nav aria-label={t("footer.resourcesAria")} class="flex flex-col gap-3">
        <span
          class="text-xs font-display font-bold uppercase tracking-widest text-[var(--text-primary)]"
          aria-hidden="true">{t("footer.resourcesHeading")}</span
        >
        <Link href={`${BASE}writeups`} class="!text-xs" aria-label={t("footer.writeupsAria")}
          >{t("footer.writeups")}</Link
        >
        <Link href={`${BASE}uses`} class="!text-xs" aria-label={t("footer.usesAria")}
          >{t("footer.uses")}</Link
        >
        <Link
          href="https://blog.luminaw.co"
          target="_blank"
          class="!text-xs"
          aria-label={t("footer.blogAria")}>{t("nav.blog")}</Link
        >
      </nav>
    </div>

    <div class="border-t border-[var(--border-base)] pt-8 w-full flex flex-col items-center gap-3">
      <p class="text-sm text-[var(--text-primary)]">{t("footer.cta")}</p>
      <Link
        href="https://luminaw.co"
        target="_blank"
        class="!text-xs"
        aria-label={t("footer.luminaAria")}
      >
        {t("footer.discover")}
      </Link>
    </div>

    <div class="pt-4 text-xs text-[var(--text-primary)] text-center">
      <span>© {year} Valentina Ramírez</span>
    </div>
  </div>
</footer>
