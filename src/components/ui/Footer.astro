---
import Link from "@/components/ui/Link.astro";
import { getLangFromUrl, useTranslations, homeHref } from "@/i18n/utils";
import type { Lang } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const BASE = import.meta.env.BASE_URL;
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = homeHref(lang);
const year = new Date().getFullYear();

const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string): "page" | undefined => {
  const url = new URL(href, Astro.url);
  if (url.hash) return undefined;
  return normalizePath(url.pathname) === currentPath ? "page" : undefined;
};
---

<footer class="w-full border-t border-[var(--border-base)] mt-24">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between gap-10 mb-10">
      <div class="flex flex-col gap-3">
        <a href={home} aria-label={t("nav.homeAria")}>
          <img
            src={`${BASE}brand/logo-w.webp`}
            alt=""
            class="h-10 w-auto"
            width="120"
            height="40"
          />
        </a>
        <p class="text-xs text-[var(--text-primary)] max-w-[240px]">{t("footer.tagline")}</p>
        <div class="flex items-center gap-3 mt-2">
          <Link
            href="https://linkedin.com/in/wavival"
            target="_blank"
            icon="linkedin"
            aria-label={t("footer.linkedinAria")}
          />
          <Link
            href="https://github.com/wavival"
            target="_blank"
            icon="github"
            aria-label={t("footer.githubAria")}
          />
          <Link
            href="https://instagram.com/wavival"
            target="_blank"
            icon="instagram"
            aria-label={t("footer.instagramAria")}
          />
        </div>
      </div>

      <nav aria-label={t("footer.siteNavAria")} class="flex flex-col gap-3">
        <h2
          class="text-xs font-display font-bold uppercase tracking-widest text-[var(--text-primary)]"
        >
          {t("footer.navHeading")}
        </h2>
        <Link
          href={lang === "en" ? `${BASE}en/projects` : `${BASE}proyectos`}
          class="!text-xs"
          aria-label={t("nav.projects")}
          aria-current={isCurrent(lang === "en" ? `${BASE}en/projects` : `${BASE}proyectos`)}
          >{t("nav.projects")}</Link
        >
        <Link
          href={lang === "en" ? `${BASE}en/services` : `${BASE}servicios`}
          class="!text-xs"
          aria-label={t("nav.services")}
          aria-current={isCurrent(lang === "en" ? `${BASE}en/services` : `${BASE}servicios`)}
          >{t("nav.services")}</Link
        >
        <Link href={`${home}#stack`} class="!text-xs" aria-label={t("nav.stack")}
          >{t("nav.stack")}</Link
        >
        <Link
          href={lang === "en" ? `${BASE}en/about` : `${BASE}sobre-mi`}
          class="!text-xs"
          aria-label={t("nav.about")}
          aria-current={isCurrent(lang === "en" ? `${BASE}en/about` : `${BASE}sobre-mi`)}
          >{t("nav.about")}</Link
        >
        <Link
          href={lang === "en" ? `${BASE}en/contact` : `${BASE}contacto`}
          class="!text-xs"
          aria-label={t("nav.contact")}
          aria-current={isCurrent(lang === "en" ? `${BASE}en/contact` : `${BASE}contacto`)}
          >{t("nav.contact")}</Link
        >
      </nav>

      <nav aria-label={t("footer.resourcesAria")} class="flex flex-col gap-3">
        <h2
          class="text-xs font-display font-bold uppercase tracking-widest text-[var(--text-primary)]"
        >
          {t("footer.resourcesHeading")}
        </h2>
        <Link
          href="https://github.com/wavival?tab=repositories"
          target="_blank"
          class="!text-xs"
          aria-label={t("footer.reposAria")}>{t("footer.repos")}</Link
        >
        <Link
          href={lang === "en" ? `${BASE}en/uses` : `${BASE}herramientas`}
          class="!text-xs"
          aria-label={t("footer.usesAria")}
          aria-current={isCurrent(lang === "en" ? `${BASE}en/uses` : `${BASE}herramientas`)}
          >{t("footer.uses")}</Link
        >
        <Link
          href="https://blog.luminaw.co"
          target="_blank"
          class="!text-xs"
          aria-label={t("footer.blogAria")}>{t("nav.blog")}</Link
        >
        <Link
          href={lang === "en" ? `${BASE}en/privacy` : `${BASE}privacidad`}
          class="!text-xs"
          aria-label={t("footer.privacyAria")}
          aria-current={isCurrent(lang === "en" ? `${BASE}en/privacy` : `${BASE}privacidad`)}
          >{t("footer.privacy")}</Link
        >
      </nav>
    </div>

    <div class="border-t border-[var(--border-base)] pt-8 w-full flex flex-col items-center gap-3">
      <p class="text-sm text-[var(--text-primary)]">{t("footer.cta")}</p>
      <Link
        href="https://luminaw.co"
        target="_blank"
        class="!text-xs"
        aria-label={t("footer.luminaAria")}
      >
        {t("footer.discover")}
      </Link>
    </div>

    <div class="pt-4 text-xs text-[var(--text-primary)] text-center">
      <span>© {year} Valentina Ramírez</span>
    </div>
  </div>
</footer>
