---
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import { getLangFromUrl, useTranslations, getAltLangUrl, homeHref } from "@/i18n/utils";
import type { Lang } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const BASE = import.meta.env.BASE_URL;
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = homeHref(lang);
const alt = getAltLangUrl(Astro.url);

const projectsHref = lang === "en" ? `${BASE}en/projects` : `${BASE}proyectos`;
const servicesHref = lang === "en" ? `${BASE}en/services` : `${BASE}servicios`;
const aboutHref = lang === "en" ? `${BASE}en/about` : `${BASE}sobre-mi`;
const contactHref = lang === "en" ? `${BASE}en/contact` : `${BASE}contacto`;

const desktopLinks = [
  { href: projectsHref, label: t("nav.projects"), aria: t("nav.projects") },
  { href: servicesHref, label: t("nav.services"), aria: t("nav.services") },
  { href: `${home}#stack`, label: t("nav.stack"), aria: t("nav.stack") },
  { href: aboutHref, label: t("nav.about"), aria: t("nav.about") },
];
---

<header
  class="fixed w-full top-0 z-50 backdrop-blur-md bg-[var(--nav-blur)] border-b border-[var(--border-base)]"
>
  <nav
    aria-label={t("nav.mainAria")}
    class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between"
  >
    <a href={home} aria-label={t("nav.homeAria")}>
      <img src={`${BASE}brand/logo-w.webp`} alt="wavival.dev" width="72" height="40" />
    </a>

    <ul class="hidden md:flex items-center gap-8" role="list">
      {
        desktopLinks.map((l) => (
          <li>
            <Link href={l.href} aria-label={l.aria}>
              {l.label}
            </Link>
          </li>
        ))
      }
      <li>
        <Button
          href="mailto:wavival.dev@luminaw.co"
          icon="send-email-white"
          aria-label={t("common.emailAria")}
        >
          {t("nav.contactCta")}
        </Button>
      </li>
      <li>
        <a
          href={alt.href}
          hreflang={alt.lang}
          aria-label={t("nav.toggleAria")}
          class="flex items-center gap-1 text-sm font-semibold text-[var(--accent-link)] hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)] rounded p-1"
        >
          <img
            src={`${BASE}icons/ui/translate.svg`}
            alt=""
            width="20"
            height="20"
            class="w-5 h-5"
          />
          <span class="font-semibold">{t("nav.toggleLabel")}</span>
        </a>
      </li>
      <li>
        <button
          id="theme-toggle-desktop"
          aria-label={t("nav.theme")}
          class="p-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]"
        >
          <img
            id="sun-desktop"
            src={`${BASE}icons/ui/sun.svg`}
            alt=""
            class="w-5 h-5 hidden"
            width="20"
            height="20"
          />
          <img
            id="moon-desktop"
            src={`${BASE}icons/ui/moon.svg`}
            alt=""
            class="w-5 h-5"
            width="20"
            height="20"
          />
        </button>
      </li>
    </ul>

    <div class="flex md:hidden items-center gap-2">
      <Button
        href="mailto:wavival.dev@luminaw.co"
        icon="send-email-white"
        aria-label={t("common.emailAria")}
      >
        {t("nav.contactCta")}
      </Button>
      <a
        href={alt.href}
        hreflang={alt.lang}
        aria-label={t("nav.toggleAria")}
        class="flex items-center gap-1 text-sm font-semibold text-[var(--accent-link)] hover:opacity-80 p-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]"
      >
        <img src={`${BASE}icons/ui/translate.svg`} alt="" width="20" height="20" class="w-5 h-5" />
        <span>{t("nav.toggleLabel")}</span>
      </a>
      <button
        id="theme-toggle-mobile"
        aria-label={t("nav.theme")}
        class="p-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]"
      >
        <img
          id="sun-mobile"
          src={`${BASE}icons/ui/sun.svg`}
          class="w-5 h-5 hidden"
          alt=""
          width="20"
          height="20"
        />
        <img
          id="moon-mobile"
          src={`${BASE}icons/ui/moon.svg`}
          class="w-5 h-5"
          alt=""
          width="20"
          height="20"
        />
      </button>
      <button
        id="menu-btn"
        class="p-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-link)]"
        aria-label={t("nav.openMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <img
          id="icon-open"
          src={`${BASE}icons/ui/open-menu.svg`}
          class="w-6 h-6"
          alt=""
          width="24"
          height="24"
        />
        <img
          id="icon-close"
          src={`${BASE}icons/ui/close-menu.svg`}
          class="w-6 h-6 hidden"
          alt=""
          width="24"
          height="24"
        />
      </button>
    </div>
  </nav>

  <nav
    id="mobile-menu"
    aria-label={t("nav.mobileAria")}
    class="md:hidden fixed left-0 right-0 z-40 flex flex-col gap-8 px-8 py-10 bg-[var(--bg-page)] border-t border-[var(--border-base)] transition-all duration-300 ease-in-out opacity-0 pointer-events-none translate-y-2"
    style="top: 64px;"
  >
    <Link href={home} class="!text-base block" aria-label={t("nav.home")}>
      {t("nav.home")}
    </Link>
    {
      desktopLinks.map((l) => (
        <Link href={l.href} class="!text-base block" aria-label={l.aria}>
          {l.label}
        </Link>
      ))
    }
    <Link href={contactHref} class="!text-base block" aria-label={t("nav.contact")}>
      {t("nav.contact")}
    </Link>
    <Button href="https://blog.luminaw.co" icon="read-more-white" aria-label={t("footer.blogAria")}>
      {t("nav.blog")}
    </Button>
  </nav>
</header>

<script>
  import "@/scripts/nav.ts";
  import "@/scripts/theme.ts";
</script>
