---
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";

interface Props {
  lang?: "es" | "en";
  showServicesLink?: boolean;
}
const { lang = "es", showServicesLink = true } = Astro.props;
const isEn = lang === "en";

const base = import.meta.env.BASE_URL;
---

<section id="contact" class="section" data-aos="fade-up">
  <p class="section-subtitle">{isEn ? "One click away" : "A un click"}</p>

  <div
    class="mt-4 flex flex-col md:flex-row md:items-center justify-between gap-12 border-t border-[var(--border-base)] pt-10"
  >
    <div class="flex flex-col gap-4 max-w-lg">
      <h2
        class="font-display font-bold text-2xl md:text-3xl text-[var(--text-primary)] leading-tight"
      >
        {isEn ? "Your next idea deserves" : "Tu próxima idea merece"}<br />
        <span class="text-[var(--brand-blue)]">
          {isEn ? "code that can carry it." : "código que la sostenga."}
        </span>
      </h2>
      <p class="text-[var(--text-muted)] leading-relaxed">
        {
          isEn
            ? "I design and build complete products: from the backend to the interface your users love. With integrated AI and security by design."
            : "Diseño y construyo productos completos: del backend a la interfaz que tus usuarios aman. Con IA integrada y seguridad desde el diseño."
        }
      </p>
    </div>

    <div class="flex flex-col gap-5 shrink-0">
      <div class="flex flex-col gap-1">
        <p class="text-sm text-[var(--text-muted)]">
          {isEn ? "Projects from " : "Proyectos desde "}
          <strong class="text-[var(--text-primary)]">
            {isEn ? "COP 2,000,000 / USD 500" : "COP 2.000.000 / USD 500"}
          </strong>
          {isEn ? " depending on scope." : " según alcance."}
        </p>
        <p class="text-xs text-[var(--text-muted)]">
          {
            isEn
              ? "Limited availability, I respond within 24h."
              : "Disponibilidad limitada, respondo en 24h."
          }
        </p>
      </div>
      <div class="flex items-center gap-4 flex-wrap">
        <Button
          href={isEn ? `${base}en/contact` : `${base}contacto`}
          icon="send-email-white"
          aria-label={isEn ? "Go to the contact page" : "Ir a la página de contacto"}
        >
          {isEn ? "Start my project" : "Quiero mi producto"}
        </Button>
        {
          showServicesLink && (
            <Link
              href={isEn ? `${base}en/services` : `${base}servicios`}
              aria-label={
                isEn
                  ? "See Valentina Ramirez's full services"
                  : "Ver los servicios completos de Valentina Ramírez"
              }
            >
              {isEn ? "See services" : "Ver servicios"}
            </Link>
          )
        }
      </div>
    </div>
  </div>
</section>
