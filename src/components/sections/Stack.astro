---
import Link from "@/components/ui/Link.astro";
import { stack } from "@/data/stack";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";

const base = import.meta.env.BASE_URL;
---

<section id="stack" class="section !pb-0" data-aos="fade-up">
  <p class="section-subtitle">{isEn ? "What I work with" : "Con qué trabajo"}</p>
  <h2 class="section-title">{isEn ? "Go-to stack" : "Stack favorito"}</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
    {
      stack.map((s, index) => (
        <article
          class="card-plain flex flex-col gap-4"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <div>
            <h3 class="font-display font-bold text-lg text-[var(--brand-blue-text)]">
              {s.category}
            </h3>
            <p class="text-xs mt-1 italic">
              {isEn ? (s.descriptionEn ?? s.description) : s.description}
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            {s.tools.map((t) => (
              <span class="chip !text-[var(--text-primary)]">{t}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-8 flex justify-center">
    <Link
      href={isEn ? `${base}en/uses` : `${base}herramientas`}
      aria-label={isEn
        ? "Technical criteria: tools breakdown and why I use them"
        : "Criterio técnico: detalle de herramientas y por qué las uso"}
    >
      {isEn ? "Technical criteria" : "Criterio técnico"}
    </Link>
  </div>
</section>
