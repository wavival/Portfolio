---
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import { projects } from "@/data/projects";

interface Props {
  /** When true, show only the flagship case studies plus a link to the full list. */
  featured?: boolean;
}

const { featured = false } = Astro.props;

const base = import.meta.env.BASE_URL;

const featuredSlugs = ["terracore", "root", "nullbreach"];
const list = featured ? projects.filter((p) => featuredSlugs.includes(p.slug)) : projects;

const tagStyles: Record<string, string> = {
  green: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
  blue: "bg-blue-100 text-[var(--brand-blue)] dark:bg-blue-900/30",
  orange: "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
  gray: "bg-[var(--bg-blur)] text-[var(--text-muted)]",
};
---

<section id="projects" class="section !pb-0" data-aos="fade-up">
  <p class="section-subtitle">Lo que he construido</p>
  <h2 class="section-title">Proyectos & Laboratorio</h2>

  <div class="flex flex-col gap-8 mt-10">
    {
      list.map((p, index) => (
        <article class="card flex flex-col gap-4" data-aos="fade-up" data-aos-delay={index * 100}>
          {"image" in p && (
            <img
              src={`${import.meta.env.BASE_URL}${p.image}`}
              alt={p.imageAlt}
              width={p.imageWidth}
              height={p.imageHeight}
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-[var(--radius-md)] border border-[var(--border-base)]"
            />
          )}

          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <h3 class="font-display font-bold text-xl text-[var(--text-primary)]">{p.title}</h3>
              <span class={`text-xs font-semibold px-3 py-1 rounded-full ${tagStyles[p.tagColor]}`}>
                {p.tag}
              </span>
            </div>
            <div class="flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <span class="chip !text-[var(--text-primary)]">{s}</span>
              ))}
            </div>
          </div>

          <div class="flex flex-col md:flex-row gap-6 text-sm text-[var(--text-muted)]">
            <div class="flex-1">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                Problema
              </span>
              <p class="mt-1">{p.problem}</p>
            </div>
            <div class="flex-1">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                Solución
              </span>
              <p class="mt-1">{p.solution}</p>
            </div>
          </div>

          {"architecture" in p && (
            <div class="text-sm text-[var(--text-muted)]">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                Qué construí
              </span>
              <ul class="mt-1 list-disc pl-5 space-y-1">
                {p.architecture.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          )}

          {(p.links.length > 0 || p.caseStudy) && (
            <div class="flex gap-4 flex-wrap">
              {p.caseStudy && (
                <Link
                  href={`${base}projects/${p.slug}`}
                  class="!text-xs"
                  aria-label={`Leer el caso de estudio de ${p.title}`}
                >
                  Caso de estudio
                </Link>
              )}
              {p.links.map((l) => (
                <Link href={l.href} class="!text-xs" target="_blank" aria-label={l.ariaLabel}>
                  {l.text}
                </Link>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>

  {
    featured && (
      <div class="mt-12 flex justify-center" data-aos="fade-up">
        <Button href={`${base}projects`} aria-label="Ver todos los proyectos y el laboratorio">
          Ver todos los proyectos
        </Button>
      </div>
    )
  }
</section>
