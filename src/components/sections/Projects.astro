---
import Link from "@/components/ui/Link.astro";

const projects = [
  {
    title: "TerraCore",
    tag: "Live",
    tagColor: "green",
    image: "images/terracore-dashboard.webp",
    imageAlt:
      "Dashboard de TerraCore: métricas en tiempo real, gráficas de producción y distribución de ganado",
    imageWidth: 1280,
    imageHeight: 846,
    stack: ["Django", "DRF", "PostgreSQL", "JWT", "React"],
    problem:
      "El agro colombiano decide por experiencia, no por datos, y paga sobreprecio del 15–30% en compras de urgencia, pierde insumos por falta de rotación y no sabe qué lote es rentable.",
    solution:
      "TerraCore digitaliza la operación agropecuaria en una sola plataforma: inventario, producción, salud animal y dashboard en tiempo real.",
    architecture: [
      "API REST desacoplada: Django REST Framework con autenticación JWT; el frontend React consume la API de forma independiente.",
      "Multiusuario y multirol: permisos granulares por rol dentro de cada organización.",
      "Offline-first: el frontend opera sin conexión y sincroniza al recuperar la red.",
      "Módulos integrados: inventario, producción, salud animal y reportes en una sola plataforma.",
    ],
    links: [
      { href: "https://terracoreapp.co/", text: "Ver sitio", ariaLabel: "Ver sitio de TerraCore" },
      {
        href: "https://app.terracoreapp.co/login",
        text: "Ver demo",
        ariaLabel: "Ver demo de TerraCore",
      },
    ],
  },
  {
    title: "Root",
    tag: "Coming soon",
    tagColor: "orange",
    stack: ["Django", "DRF", "PostgreSQL", "React", "Claude API"],
    problem:
      "Comer con celiaquía, diabetes o intolerancia a la lactosa implica leer cada etiqueta, descifrar ingredientes escondidos bajo otros nombres y buscar recetas que cumplan varias restricciones a la vez.",
    solution:
      "Root consolida eso en una PWA con scanner de etiquetas por IA personalizado a tus condiciones, recetas curadas bajo reglas estrictas y diario offline. Pensada para quien ya sabe qué no puede comer, y quiere saber qué sí.",
    links: [
      {
        href: "https://wavival.dev/root/",
        text: "Ver demo",
        ariaLabel: "Ver demo de Root",
      },
    ],
  },
  {
    title: "NullBreach",
    tag: "Live",
    tagColor: "green",
    stack: ["Django", "DRF", "PostgreSQL", "JWT", "Claude API"],
    problem:
      "Revisar código con criterio OWASP o resolver una duda puntual de ciberseguridad implica saltar entre scanners pesados, documentación dispersa y foros.",
    solution:
      "NullBreach consolida eso en una app con chat de IA y análisis de código contra OWASP Top 10. Ideal para integrar seguridad sin complicaciones.",
    links: [
      {
        href: "https://wavival.dev/nullbreach/",
        text: "Ver demo",
        ariaLabel: "Ver demo de NullBreach",
      },
      {
        href: "https://github.com/wavival/nullbreach-api",
        text: "Ver repositorio",
        ariaLabel: "Ver repositorio de NullBreach",
      },
    ],
  },
  {
    title: "Lúmina W",
    tag: "Live",
    tagColor: "green",
    image: "images/lumina-w.webp",
    imageAlt: "Lúmina W — Creamos software. Los negocios lo rentan.",
    imageWidth: 1280,
    imageHeight: 853,
    stack: ["Astro", "Tailwind", "Formspree"],
    problem: "Toda empresa necesita una presencia digital que comunique quién es y qué hace.",
    solution:
      "Lúmina W es mi empresa. Diseñé la marca, construí la landing y la mantengo mientras desarrollo los productos que la sostienen.",
    links: [{ href: "https://luminaw.co", text: "Ver sitio", ariaLabel: "Ver sitio de Lúmina W" }],
  },
  {
    title: "Forgotten Portal",
    tag: "Laboratorio",
    tagColor: "gray",
    image: "images/forgotten-portal.webp",
    imageAlt: "Forgotten Portal — laboratorio de pentesting (DockerLabs)",
    imageWidth: 1280,
    imageHeight: 853,
    stack: ["Nmap", "Gobuster", "Netcat", "PTES", "MITRE ATT&CK"],
    problem:
      "¿Qué tan vulnerable es un sistema mal configurado ante un atacante con acceso inicial mínimo?",
    solution:
      "Ejercicio completo de pentesting: reconocimiento, explotación de PHP upload, reverse shell, escalada de privilegios a root. Documentado con metodología PTES y TTPs mapeados a MITRE ATT&CK.",
    links: [
      {
        href: "https://blog.luminaw.co/forgotten-portal-pentesting-dockerlabs/",
        text: "Ver writeup",
        ariaLabel: "Ver writeup de Forgotten Portal",
      },
      {
        href: "https://github.com/wavival/forgotten-portal-writeup",
        text: "Ver repositorio",
        ariaLabel: "Ver repositorio de Forgotten Portal",
      },
    ],
  },
];

const tagStyles: Record<string, string> = {
  green: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400",
  blue: "bg-blue-100 text-[var(--brand-blue)] dark:bg-blue-900/30",
  orange: "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
  gray: "bg-[var(--bg-blur)] text-[var(--text-muted)]",
};
---

<section id="projects" class="section !pb-0" data-aos="fade-up">
  <p class="section-subtitle">En qué estoy trabajando</p>
  <h2 class="section-title">Proyectos & Laboratorio</h2>

  <div class="flex flex-col gap-8 mt-10">
    {
      projects.map((p, index) => (
        <article class="card flex flex-col gap-4" data-aos="fade-up" data-aos-delay={index * 100}>
          {"image" in p && (
            <img
              src={`${import.meta.env.BASE_URL}${p.image}`}
              alt={p.imageAlt}
              width={p.imageWidth}
              height={p.imageHeight}
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-[var(--radius-md)] border border-[var(--border-base)]"
            />
          )}

          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <h3 class="font-display font-bold text-xl text-[var(--text-primary)]">{p.title}</h3>
              <span class={`text-xs font-semibold px-3 py-1 rounded-full ${tagStyles[p.tagColor]}`}>
                {p.tag}
              </span>
            </div>
            <div class="flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <span class="chip !text-[var(--text-primary)]">{s}</span>
              ))}
            </div>
          </div>

          <div class="flex flex-col md:flex-row gap-6 text-sm text-[var(--text-muted)]">
            <div class="flex-1">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                Problema
              </span>
              <p class="mt-1">{p.problem}</p>
            </div>
            <div class="flex-1">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                Solución
              </span>
              <p class="mt-1">{p.solution}</p>
            </div>
          </div>

          {"architecture" in p && (
            <div class="text-sm text-[var(--text-muted)]">
              <span class="text-xs font-bold uppercase tracking-widest text-[var(--brand-blue)]">
                Decisiones de arquitectura
              </span>
              <ul class="mt-1 list-disc pl-5 space-y-1">
                {p.architecture.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          )}

          {p.links.length > 0 && (
            <div class="flex gap-4">
              {p.links.map((l) => (
                <Link href={l.href} class="!text-xs" target="_blank" aria-label={l.ariaLabel}>
                  {l.text}
                </Link>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>
